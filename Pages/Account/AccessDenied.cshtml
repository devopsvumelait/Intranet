@page
@model Intranet.Pages.Account.AccessDeniedModel
@{
    ViewData["Title"] = "Access Denied";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow-sm border-0 py-5">
                <div class="card-body">
                    <i class="bi bi-shield-lock-fill text-danger" style="font-size: 4rem;"></i>
                    <h1 class="display-5 fw-bold mt-3">Access Denied</h1>
                    <p class="text-muted mb-4">
                        Sorry, you do not have the required permissions to view this page.                    
                    </p>
                    <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                        <a asp-page="/Account/Login"
                               asp-page-handler="Logout"
                               class="btn btn-outline-secondary px-4 py-2">
                            Return to Login
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>