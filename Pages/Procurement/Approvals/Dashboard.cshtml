@page
@model Intranet.Pages.Procurement.Approvals.DashboardModel
@{
    ViewData["Title"] = "Executive Hub";
}

<div class="container mt-4">
    <div class="card shadow-sm mb-4 bg-dark text-white">
        <div class="card-body d-flex justify-content-between align-items-center">

            <div>
                <h4 class="mb-0">👋 Welcome, @Model.UserFullName</h4>

            </div>

            <div class="text-start">
                <div id="dateTime" class="fw-bold text-white"></div>

            </div>

        </div>
    </div>

    <script>
            function updateDateTime() {
                const now = new Date();
                document.getElementById("dateTime").innerText =
                    now.toLocaleDateString() + " " + now.toLocaleTimeString();
            }

            updateDateTime();
            setInterval(updateDateTime, 1000);
    </script>


    <div class="row align-items-center mb-4">
        <div class="col-md-8">
            <h3 class="text-dark fw-bold mb-0">Executive Approval Hub</h3>
            <p class="text-muted">Real-time procurement oversight and authorization.</p>
        </div>
        <div class="col-md-4 text-md-end">
            <div class="badge bg-light text-dark border p-2">
                <i class="bi bi-calendar3 me-2"></i> @DateTime.Now.ToString("MMMM yyyy")
            </div>
        </div>
    </div>

    <div class="row mb-4">
        @* Metric 1: Pending Requests *@
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-dark text-white">
                <div class="card-body p-4">
                    <h6 class="text-white-50 small text-uppercase fw-bold">Pending Queue</h6>
                    <h2 class="mb-0">@Model.PendingQueue.Count</h2>
                    <p class="small mb-0 mt-2">Value: R @Model.TotalPendingValue.ToString("N2")</p>
                </div>
            </div>
        </div>

        @* Metric 2: Total Approved (MTD) *@
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-white border-start border-success border-4">
                <div class="card-body p-4">
                    <h6 class="text-muted small text-uppercase fw-bold">Authorized (MTD)</h6>
                    <h2 class="mb-0 text-success">@Model.ApprovedThisMonth</h2>
                    <p class="small text-muted mb-0 mt-2">Spend: R @Model.TotalSpendThisMonth.ToString("N2")</p>
                </div>
            </div>
        </div>

        @* Metric 3: Total Rejected (MTD) *@
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-white border-start border-danger border-4">
                <div class="card-body p-4">
                    <h6 class="text-muted small text-uppercase fw-bold">Rejected (MTD)</h6>
                    <h2 class="mb-0 text-danger">@Model.RejectedThisMonth</h2>
                    <p class="small text-muted mb-0 mt-2">Requests denied this month</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h6 class="mb-0 fw-bold">Pending Approval Queue</h6>
                        <span class="badge rounded-pill bg-light text-dark border">Priority Order</span>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr class="text-muted small text-uppercase">
                                    <th class="ps-4">ID</th>
                                    <th>Requester</th>
                                    <th>Supplier Name</th>
                                    <th>Department</th>
                                    <th>Type</th>
                                    <th>Amount</th>
                                    
                                    <th class="text-end pe-4">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.PendingQueue.Any())
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-5 text-muted">
                                            <i class="bi bi-inbox display-6 d-block mb-2"></i>
                                            All clear! No requests currently in your queue.
                                        </td>
                                    </tr>
                                }
                                @foreach (var item in Model.PendingQueue)
                                {
                                    <tr>
                                        <td class="ps-4 text-muted small">#@item.Id</td>
                                        <td>
                                            <div class="fw-bold">@item.Requester.FirstName @item.Requester.Surname</div>
                                            <div class="small text-muted">Dept ID: @item.Requester.DepartmentId</div>
                                        </td>
                                        <td>                                        
                                            <div class="fw-bold text-dark text-truncate" style="max-width: 150px;">
                                                @(item.Quotes?.FirstOrDefault(q => q.IsSelected)?.SupplierName ?? "No Supplier Found")
                                            </div>
                                        </td>
                                        <td>
                                            <div class="badge bg-light text-dark border" style="max-width: 150px;">@item.DepartmentType</div>
                                        </td>
                                        
                                        <td>
                                            <span class="badge @(item.CostType == "BAU" ? "bg-info text-dark" : "bg-light text-dark border")">
                                                @item.CostType
                                            </span>
                                        </td>
                                        <td class="fw-bold text-primary">R @item.TotalAmount.ToString("N2")</td>
                                        <td class="text-end pe-4">
                                            <a asp-page="/Procurement/Approvals/Review" asp-route-id="@item.Id"
                                               class="btn btn-dark btn-sm px-3 shadow-sm">Review Details</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm mb-4 border-start border-primary border-4">
                <div class="card-header bg-white border-bottom pt-3 pb-2 d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold">Recent Alerts</h6>
                    @if (Model.Notifications != null && Model.Notifications.Any())
                    {
                        <form method="post" asp-page-handler="MarkAllRead">
                            <button type="submit" class="btn btn-link p-0 text-decoration-none small text-muted" style="font-size:0.7rem">Acknowledge All</button>
                        </form>
                    }
                </div>
                <div class="card-body p-0">
                    @if (Model.Notifications == null || !Model.Notifications.Any())
                    {
                        <div class="py-5 text-center">
                            <i class="bi bi-bell-slash text-muted d-block mb-2 fs-4"></i>
                            <p class="text-muted small mb-0 px-4">No new notifications. All requests acknowledged.</p>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var note in Model.Notifications.Take(5))
                            {
                                <div class="list-group-item py-3 px-4 border-0 border-bottom">
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="badge bg-primary rounded-pill" style="font-size:0.6rem">@note.Title</span>
                                        <small class="text-muted" style="font-size:0.7rem">@(note.CreatedAt?.ToString("MMM dd") ?? "")</small>
                                    </div>
                                    <p class="mb-2 small text-dark fw-medium">@note.Message</p>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>