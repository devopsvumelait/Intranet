<div id="budgetTracking" class="report-section" style="display:none;">

    <div class="row g-3">

        <!-- Forecast Card -->
        <div class="col-md-4">
            <div class="card shadow-sm p-3">
                <div class="text-muted small fw-bold">Predicted Next Month Forecast</div>
                <h3 class="fw-bold text-primary">
                    R @Model.ForecastNextMonthSpend.ToString("N2")
                </h3>
            </div>
        </div>

        <!-- Top Suppliers -->
        <div class="col-md-8">
            <div class="card shadow-sm p-3">
                <div class="fw-bold mb-2">Top 5 Suppliers</div>

                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Supplier</th>
                            <th>Spend</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.TopSuppliers)
                        {
                            <tr>
                                <td>@s.Supplier</td>
                                <td>R @s.TotalSpend.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>

            </div>
        </div>

        <!-- Chart -->
        <div class="col-12">
            <div class="card shadow-sm p-3">
                <div style="height: 350px;">
                    <canvas id="budgetChart"></canvas>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Dynamically shifts tracking queries for excel generation matching browser navigation selections
        function updateExportTarget(tabKey) {
        const exportBtn = document.getElementById('globalExportBtn');
        if (exportBtn) {
        const url = new URL(exportBtn.href, window.location.origin);
        url.searchParams.set('tab', tabKey);
        exportBtn.href = url.pathname + url.search;
        }
        }

        // Core Report Section Switching Logic (Available globally)
        function showReport(id) {
        document.querySelectorAll('.report-section')
        .forEach(el => el.style.display = 'none');

        const section = document.getElementById(id);
        if (section) section.style.display = 'block';

        document.querySelectorAll('#reportTypeTabs .nav-link')
        .forEach(btn => btn.classList.remove('active'));

        const activeBtn = document.querySelector(`[data-report="${id}"]`);
        if (activeBtn) activeBtn.classList.add('active');

        if (id === "budgetTracking" && window.budgetChartInstance) {
        window.budgetChartInstance.resize();
        }
        }

        // Status Pie Chart Initialization
        const ctx = document.getElementById('statusChart');
        const canViewHighValue = @(Model.CanViewHighValueMDQueue ? "true" : "false");
        const isFinanceRole = @(User.IsInRole("Finance") ? "true" : "false");

        let chartLabels, chartData, chartColors;

        if (canViewHighValue) {
        chartLabels = ['Accepted / Finance', 'Pending Review', 'Pending MD (>15k)', 'Denied', 'Paid / Invoice', 'Closed Log'];
        chartData = [@Model.AcceptedWaitingOnFinance, @Model.Pending, @Model.PendingOnMD, @Model.Denied, @Model.PaidPendingOnManager, @Model.Closed];
        chartColors = ['#0d6efd', '#ffc107', '#fd7e14', '#dc3545', '#0dcaf0', '#198754'];
        } else if (isFinanceRole) {
        chartLabels = ['Accepted / Finance', 'Pending Review', 'Paid / Invoice', 'Closed Log'];
        chartData = [@Model.AcceptedWaitingOnFinance, @Model.Pending, @Model.PaidPendingOnManager, @Model.Closed];
        chartColors = ['#0d6efd', '#ffc107', '#0dcaf0', '#198754'];
        } else {
        chartLabels = ['Accepted / Finance', 'Pending Review', 'Denied', 'Paid / Invoice', 'Closed Log'];
        chartData = [@Model.AcceptedWaitingOnFinance, @Model.Pending, @Model.Denied, @Model.PaidPendingOnManager, @Model.Closed];
        chartColors = ['#0d6efd', '#ffc107', '#dc3545', '#0dcaf0', '#198754'];
        }

        if (ctx) {
        new Chart(ctx, {
        type: 'pie',
        data: {
        labels: chartLabels,
        datasets: [{
        data: chartData,
        backgroundColor: chartColors,
        borderColor: '#ffffff',
        borderWidth: 2
        }]
        },
        options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
        legend: { position: 'bottom', labels: { boxWidth: 12, font: { weight: 'bold' } } }
        }
        }
        });
        }
    </script>

    @if (Model.BudgetForecast != null)
    {
        <script>
            const budgetLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                    Model.BudgetForecast.Select(x => x.Period)
                ));

            const actualData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                    Model.BudgetForecast.Select(x => x.Actual)
                ));

            const forecastData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                    Model.BudgetForecast.Select(x => x.Forecast)
                ));

            const budgetCtx = document.getElementById('budgetChart');
            if (budgetCtx) {
            window.budgetChartInstance = new Chart(budgetCtx, {
            type: 'line',
            data: {
            labels: budgetLabels,
            datasets: [
            { label: "Actual Spend", data: actualData, borderColor: '#0d6efd', tension: 0.3 },
            { label: "Forecast", data: forecastData, borderColor: '#6c757d', borderDash: [6, 6], tension: 0.3 }
            ]
            },
            options: {
            responsive: true,
            maintainAspectRatio: false
            }
            });
            }
        </script>
    }
}