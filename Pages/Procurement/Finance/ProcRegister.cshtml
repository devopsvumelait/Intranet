@page
@model ProcRegister
@using System.Globalization

<div class="container mt-4">
    <div class="row mb-4 align-items-end">
        <div class="col-md-6">
            <h3 class="fw-bold">Procurement Register</h3>
            <p class="text-muted">Viewing records for @CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(Model.SelectedMonth) @Model.SelectedYear</p>
        </div>
        <div class="col-md-6 text-end">
            <a href="/registers/@Model.TargetFileName" class="btn btn-success shadow-sm" download>
                <i class="bi bi-file-earmark-excel me-2"></i>Download @CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(Model.SelectedMonth) Register
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body bg-light">
            <form method="get" class="row g-3">
                <div class="col-md-4">
                    <label class="form-label small fw-bold">Month</label>
                    <select asp-for="SelectedMonth" class="form-select">
                        @for (int i = 1; i <= 12; i++)
                        {
                            <option value="@i">@CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-bold">Year</label>
                    <select asp-for="SelectedYear" class="form-select">
                        @{
                            var currentSaYear = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, TimeZoneInfo.FindSystemTimeZoneById("South Africa Standard Time")).Year;
                        }
                        @for (int i = currentSaYear - 2; i <= currentSaYear; i++)
                        {
                            <option value="@i">@i</option>
                        }
                    </select>
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button type="submit" class="btn btn-dark w-100">
                        <i class="bi bi-funnel me-2"></i>Apply Filter
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-uppercase position-sticky top-0" style="z-index: 1;">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Requester</th>
                        <th>Department</th>
                        <th>Supplier</th>
                        <th>Amount</th>
                        <th class="text-end pe-4">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.MasterList.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                No closed requests found for this period.
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model.MasterList)
                    {
                        <tr>
                            <td class="ps-4">#@item.Id</td>
                            <td>
                                <div class="fw-bold">@item.Requester.FirstName @item.Requester.Surname</div>
                            </td>
                            <td>@item.Requester.Department?.Name</td>
                            <td>@(item.Quotes.FirstOrDefault(q => q.IsSelected)?.SupplierName ?? "N/A")</td>
                            <td class="text-primary fw-bold">R @item.TotalAmount.ToString("N2")</td>
                            <td class="text-end pe-4">
                                <span class="badge bg-success">Verified & Closed</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>