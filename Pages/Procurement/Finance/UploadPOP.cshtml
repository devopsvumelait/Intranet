@page "{id:int}"
@model Intranet.Pages.Procurement.Finance.UploadPOP
@{
    //Fallback safety condition matching database schema states safely
    bool isPO = Model.RequestData?.Status == "PO_Upload" || Model.RequestData?.IsPoRequired == true;
    ViewData["Title"] = isPO ? "Compile Purchase Order" : "Execute Payment";
    var selectedQuote = Model.RequestData?.Quotes?.FirstOrDefault(q => q.IsSelected);
}

<div class="container mt-4">
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger shadow-sm border-0 mb-4" role="alert">
            <div class="d-flex">
                <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                <div>
                    <h6 class="alert-heading fw-bold">
                        @if (isPO)
                        {
                            <text>AI Verification Error: Please Upload Correct Purchase Order File And Matching PO Number</text>
                        }
                        else
                        {
                            <text>AI Verification Error: Please Upload Correct Proof Of Payment And Matching Reference Number</text>
                        }
                    </h6>
                </div>
            </div>
        </div>
    }

    <div class="row">
        <div class="col-lg-8">
            @if (Model.RequestData != null)
            {
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h5 class="mb-0 fw-bold">Request Detail #@Model.RequestData.Id</h5>
                    </div>
                    <div class="card-body">
                        <h6 class="text-muted text-uppercase small fw-bold mb-3">Approval History</h6>
                        <table class="table table-sm small">
                            <thead>
                                <tr class="text-muted">
                                    <th>Stage</th>
                                    <th>Approver</th>
                                    <th>Date</th>
                                    <th>Result</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var app in Model.RequestData.Approvals)
                                {
                                    <tr>
                                        <td>@app.Stage</td>
                                        <td>@app.Approver?.FirstName @app.Approver?.Surname</td>
                                        <td>@app.DecisionDate?.ToString("yyyy-MM-dd")</td>
                                        <td class="text-success fw-bold">Approved</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h6 class="text-muted text-uppercase small fw-bold mb-3">Winning Quote Information</h6>
                        <div class="bg-light p-3 rounded mb-4 border-start border-4 border-primary">
                            <h6 class="fw-bold">Quote Details:</h6>
                            <p class="mb-0">Customer Name - @Model.RequestData.CustomerName</p>
                            <p class="mb-0">Department - @Model.RequestData.DepartmentType</p>
                            <p class="mb-0">Cost Type - @Model.RequestData.CostType</p>
                            <p class="mb-0">Quote Type - @Model.RequestData.QuoteType</p>
                            <p class="mb-0">Request Type - @Model.RequestData.RequestType</p>
                        </div>

                        <div class="p-3 bg-light rounded border">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <p class="mb-0 text-muted small">Supplier</p>
                                    <h5 class="mb-0 fw-bold">@selectedQuote?.SupplierName</h5>
                                </div>
                                <div class="text-end">
                                    <p class="mb-0 text-muted small">Amount Authorized</p>
                                    <h4 class="mb-0 text-primary">R @Model.RequestData.TotalAmount.ToString("N2")</h4>
                                </div>
                            </div>
                            
                            @if (selectedQuote != null && !string.IsNullOrEmpty(selectedQuote.BlobUrl))
                            {
                                <div class="mt-3 pt-3 border-top">
                                    <a href="@selectedQuote.BlobUrl" target="_blank" class="btn btn-sm btn-outline-primary shadow-sm">
                                        <i class="bi bi-file-earmark-pdf me-1"></i> View Selected Quote PDF
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
            @if (Model.SupportingDocuments != null && Model.SupportingDocuments.Any())
            {
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body">
                        <h6 class="fw-bold mb-3"><i class="bi bi-paperclip me-2"></i>Supporting Documents</h6>
                        <div class="list-group">
                            @foreach (var doc in Model.SupportingDocuments)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center py-2 px-3">
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-file-earmark-text text-secondary h5 me-2 mb-0"></i>
                                        <span class="text-dark small fw-medium">@doc.FileName</span>
                                    </div>
                                    <a href="@doc.BlobUrl" target="_blank" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-eye me-1"></i> View Document
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }


        </div>

        

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm bg-dark text-white">
                <div class="card-body p-4">
                    <h6 class="text-white-50 text-uppercase small fw-bold mb-3">
                        @(isPO ? "Purchase Order Generation" : "Payment Processing")
                    </h6>
                    <form method="post" enctype="multipart/form-data">
                        
                        @if (Model.RequestData.RequestType != "Waybill" && Model.RequestData.RequestType != "ONLINE")
            {
                        <div class="mb-3 @(isPO ? "d-none" : "")">
                            <label class="form-label small">Payment Method</label>
                            <select asp-for="PaymentMethod" class="form-select bg-secondary text-white border-0">
                                <option value="EFT">EFT</option>
                                <option value="Cash">Cash</option>
                            </select>
                        </div>
            }


                        <div class="mb-3">
                            <label class="form-label small">
                                @(isPO ? "Manual PO Reference Number" : "Reference Number")
                            </label>
                            <input asp-for="ReferenceNumber" class="form-control bg-secondary text-white border-0" placeholder="@(isPO ? "e.g. PO-77102" : "e.g. INV-10029")" required />
                            <span asp-validation-for="ReferenceNumber" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label small">
                                @(isPO ? "Upload Manual PO Document (PDF)" : "Upload Proof of Payment (PDF) / Supporting Doc")
                            </label>
                            <input asp-for="PopFile" type="file" class="form-control bg-secondary text-white border-0" accept=".pdf" required />
                            <p class="text-white-50 x-small mt-1" style="font-size: 0.7rem;">
                                AI will verify this document against your manual input reference.
                            </p>
                        </div>

                        <div class="mb-4">
                            <label class="form-label small">Finance Comments / Notes <span class="text-white-50">(Optional)</span></label>
                            <textarea asp-for="FinanceComment" class="form-control bg-secondary text-white border-0" rows="3" placeholder="Add any remarks regarding this transaction or document..."></textarea>
                            <span asp-validation-for="FinanceComment" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-success w-100 py-2 fw-bold shadow-sm">
                            @if (isPO)
                            {
                                <span><i class="bi bi-file-earmark-check me-2"></i>Register & Save PO</span>
                            }
                            else
                            {
                                <span><i class="bi bi-cash-stack me-2"></i>Release Payment</span>
                            }
                        </button>
                    </form>
                </div>
            </div>
            
            <div class="mt-3 text-center">
                <a asp-page="./PaymentQueue" class="btn btn-link text-muted text-decoration-none small">
                    <i class="bi bi-arrow-left me-1"></i> Back to Payment Queue
                </a>
            </div>
        </div>
    </div>
</div>