@page
@model Intranet.Pages.Procurement.Finance.FinanceDashboardModel
@{
    ViewData["Title"] = "Finance Control Dashboard";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-0 text-dark fw-bold">Finance Hub</h3>
            <p class="text-muted small">Welcome back, @Model.FullName. Manage payment cycles and compliance.</p>
        </div>
        <div class="text-end">
            <div class="badge bg-light text-dark border p-2">
                <i class="bi bi-calendar3 me-2"></i> @Model.CurrentSaTime.ToString("dd MMMM yyyy")
            </div>
        </div>
    </div>

    @* METRIC CARDS *@
    <div class="row mb-5 g-3">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 @(Model.PresentDatedCount > 0 ? "bg-danger text-white pulse-border" : "bg-light")">
                <div class="card-body">
                    <h6 class="@(Model.PresentDatedCount > 0 ? "text-white-50" : "text-muted") text-uppercase fw-bold small mb-1" style="font-size:0.75rem;">Action Required</h6>
                    <h2 class="mb-0 fw-bold">@Model.PresentDatedCount</h2>
                    <small class="opacity-75 text-nowrap">Payments & PO Uploads</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 bg-primary text-white">
                <div class="card-body">
                    <h6 class="text-white-50 text-uppercase fw-bold small mb-1" style="font-size:0.75rem;">Future Dated</h6>
                    <h2 class="mb-0 fw-bold">@Model.FutureDatedCount</h2>
                    <small class="opacity-75 text-nowrap">Scheduled Payments</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 bg-warning text-dark">
                <div class="card-body">
                    <h6 class="text-dark text-opacity-50 text-uppercase fw-bold small mb-1" style="font-size:0.75rem;">Out with Managers</h6>
                    <h2 class="mb-0 fw-bold">@Model.AwaitingInvoicesCount</h2>
                    <small class="text-dark text-opacity-75 text-nowrap">Awaiting Invoice or PO Closure</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 bg-info text-white">
                <div class="card-body">
                    <h6 class="text-white-50 text-uppercase fw-bold small mb-1" style="font-size:0.75rem;">Archived / Audited</h6>
                    <h2 class="mb-0 fw-bold">@Model.AuditReviewCount</h2>
                    <small class="opacity-75 text-nowrap">Closed Procurement Files</small>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        @* MAIN WORKFLOW TABLE *@
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom pt-3 pb-2 d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="mb-0 fw-bold">Urgent Action Queue</h6>
                        <div class="text-muted x-small mt-1">
                            <span class="me-2"><i class="bi bi-circle-fill text-primary me-1"></i> Blue action indicates **PO Generation**</span>
                            <span><i class="bi bi-circle-fill text-dark me-1"></i> Black action indicates **Standard Cash Outflow**</span>
                        </div>
                    </div>
                    <span class="badge bg-light text-dark">Top 10 Priority Items</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="min-width:650px;">
                        <thead class="table-light text-muted small text-uppercase">
                            <tr>
                                <th class="ps-4">ID</th>
                                <th>Requester / Dept</th>
                                <th>Supplier Name</th>
                                <th>Description</th>
                                <th>Amount</th>
                                <th>Pay Date</th>
                                <th class="text-end pe-4">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.PendingPayments.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-4">No tasks currently pending.</td>
                                </tr>
                            }
                            @foreach (var req in Model.PendingPayments)
                            {
                                <tr class="@(req.CreatedAt <= DateTime.Today ? "table-danger-soft" : "")">
                                    <td class="ps-4 text-muted small">#@req.Id</td>
                                    <td>
                                        <div class="fw-medium text-dark">@req.Requester?.FirstName @req.Requester?.Surname</div>
                                        <div class="x-small text-muted fw-bold">@req.CostType</div>
                                    </td>
                                    <td>                                        
                                        <div class="fw-bold text-dark text-truncate" style="max-width: 180px;">
                                            @(req.Quotes?.FirstOrDefault(q => q.IsSelected)?.SupplierName ?? "No Supplier Found")
                                        </div>
                                    </td>
                                    <td>
                                        <div class="text-truncate" style="max-width: 180px;">@req.Description</div>
                                    </td>
                                    <td class="fw-bold text-nowrap">R @req.TotalAmount.ToString("N2")</td>
                                    <td class="text-nowrap">
                                        <span class="@(req.CreatedAt <= DateTime.Today ? "text-danger fw-bold" : "text-dark")">
                                            @req.CreatedAt?.ToString("MMM dd, yyyy")
                                        </span>
                                    </td>
                                    <td class="text-end pe-4 text-nowrap">
                                        @if (req.IsPoRequired)
                                        {
                                            <a asp-page="/Procurement/Finance/UploadPOP" asp-route-id="@req.Id" class="btn btn-sm btn-primary shadow-sm fw-bold">
                                                <i class="bi bi-file-earmark-arrow-up me-1"></i> Process PO
                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-page="/Procurement/Finance/UploadPOP" asp-route-id="@req.Id" class="btn btn-sm btn-dark shadow-sm fw-bold">
                                                Process Pay
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="card-footer bg-white border-top py-3 text-center">
                    <a asp-page="/Procurement/Finance/PaymentQueue" class="btn btn-link text-dark fw-bold text-decoration-none small">
                        View Full Payment Queue <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        @* SIDEBAR ALERTS *@
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm mb-4 border-start border-primary border-4">
                <div class="card-header bg-white border-bottom pt-3 pb-2 d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold">Finance Alerts</h6>
                    @if (Model.Notifications.Any())
                    {
                        <form method="post" asp-page-handler="MarkAllRead">
                            <button type="submit" class="btn btn-link p-0 text-decoration-none small text-muted" style="font-size:0.7rem">Clear All</button>
                        </form>
                    }
                </div>
                <div class="card-body p-0">
                    @if (!Model.Notifications.Any())
                    {
                        <div class="py-5 text-center">
                            <i class="bi bi-shield-check text-muted d-block mb-2 fs-4"></i>
                            <p class="text-muted small mb-0 px-4">Compliance looks good. No new alerts.</p>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var note in Model.Notifications.Take(6))
                            {
                                <div class="list-group-item py-3 px-4 border-0 border-bottom">
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="badge bg-primary rounded-pill" style="font-size:0.6rem">@note.Title</span>
                                        <small class="text-muted" style="font-size:0.7rem">@note.CreatedAt?.ToString("MMM dd")</small>
                                    </div>
                                    <p class="mb-0 small text-dark fw-medium">@note.Message</p>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .table-danger-soft { background-color: rgba(220, 53, 69, 0.05); }
    .pulse-border { border: 2px solid #dc3545; animation: pulse-red 2s infinite; }
    @@keyframes pulse-red {
        0% { box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.7); }
        70% { box-shadow: 0 0 0 10px rgba(220, 53, 69, 0); }
        100% { box-shadow: 0 0 0 0 rgba(220, 53, 69, 0); }
    }
    .x-small { font-size: 0.75rem; }
</style>